# Supabase project URL and public anon key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Project Settings > API) — server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Postgres password — used only by Supabase CLI tooling, not imported by app code
DATABASE_PASSWORD=

# Email of the single admin account allowed into /admin
ADMIN_EMAIL=

# Public site URL, used for metadata/sitemap/OG (defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
